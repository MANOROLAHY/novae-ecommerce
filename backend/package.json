{
  "name": "luxe-backend",
  "version": "1.0.0",
  "description": "API backend pour la plateforme e-commerce Luxe",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --env-file=../.env --experimental-sqlite server.js",
    "dev": "node --env-file=../.env --experimental-sqlite --watch server.js",
    "test": "node --experimental-sqlite --test tests/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "uuid": "^11.1.1"
  }
}
